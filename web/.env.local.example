# Copy this file to .env.local and fill in the SAME Supabase project values
# the mobile app uses (Project Settings > API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The SERVICE ROLE key, not the anon key — this dashboard has no login of its
# own and reads as a trusted internal server, bypassing RLS (which now
# requires an authenticated mobile-app user). Keep this secret: never prefix
# it with NEXT_PUBLIC_, never commit it, never reference it from client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
