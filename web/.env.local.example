# Copy this file to .env.local and fill in the SAME Supabase project values
# the mobile app uses (Project Settings > API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# The anon/publishable key, same one the mobile app uses. The dashboard now
# has real login (see src/app/login) and reads as that signed-in user, so
# RLS (role/branch scoping — see supabase/migrations/008_role_based_access.sql)
# enforces access the same way it does on mobile. This is NOT the
# service_role/secret key — that bypassed RLS entirely, which defeats the
# point now that access is scoped per user.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
