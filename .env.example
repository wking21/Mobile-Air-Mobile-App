# Copy this file to .env and fill in your Supabase project's values.
# Find both under Project Settings > API in the Supabase dashboard.
# The anon key is safe to ship in a client app by design — real protection
# comes from the Row Level Security policies in supabase/schema.sql, which
# require a signed-in user (see src/state/AuthContext.tsx / LoginScreen.tsx).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
